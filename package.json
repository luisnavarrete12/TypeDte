{
  "name": "typedte",
  "version": "0.1.0",
  "description": "Documentos tributarios electronicos (DTE) del SII de Chile en TypeScript: los 12 tipos, timbre, firma, envio, libros y PDF.",
  "keywords": [
    "dte",
    "sii",
    "chile",
    "facturacion electronica",
    "boleta electronica",
    "typescript"
  ],
  "author": "Luis Navarrete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisnavarrete12/TypeDte.git"
  },
  "homepage": "https://github.com/luisnavarrete12/TypeDte#readme",
  "bugs": {
    "url": "https://github.com/luisnavarrete12/TypeDte/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "ejemplo": "node --experimental-strip-types ejemplos/emitir-factura.ts"
  },
  "dependencies": {
    "libxml2-wasm": "^0.7.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.7.0"
  }
}
